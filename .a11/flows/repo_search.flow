flow repo_search {
  in  QUERY:  string required
  out python: string stream
  out native: string stream
  out docs:   string stream

  python_search = run search_text(query: QUERY, path: "a11", limit: 25)
  python_search.result.matches | flatten | first 25 | truncate 240 -> python
  native_search = run search_text(query: QUERY, path: "cpp", limit: 25)
  native_search.result.matches | flatten | first 25 | truncate 240 -> native
  docs_search = run search_text(query: QUERY, path: "doc", limit: 15)
  docs_search.result.matches | flatten | first 15 | truncate 240 -> docs
}
