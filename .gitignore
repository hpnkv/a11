# The hooks that enforce AGENTS.md prose rules and the fiber-debugging
# instruction travel with the repo; everything else under .claude is local.
.claude/*
!.claude/settings.json
.idea
.junie
.venv
__pycache__/
*.py[cod]

build*/
cmake-build-debug/
cmake-build-release/
cmake-build-relwithdebinfo/
install/
CMakeUserPresets.json
a11/libexec/a11-web-render-webkit

**/.gradle/
**/.intellijPlatform/
# tools/vcpkg was recorded as a gitlink with no .gitmodules entry and nothing in
# the build referencing it, which made every recursive clone (and any CI
# checkout asking for submodules) fail on "No url found for submodule path".
# Untracked now; keep a stray local checkout out of git's way.
tools/vcpkg/

intellij-plugin/

vscode-plugin/dist/
vscode-plugin/node_modules/

# The shared webview is built with npm; pnpm 11 creates these policy files when
# invoked there, but they are not inputs to either IDE distribution.
/webview/pnpm-lock.yaml
/webview/pnpm-workspace.yaml

.a11/docs/

# Local campaign plans, reports, exports, and draft creative.
.campaign/
