# Plan a topic, investigate briefs concurrently, and synthesise a report.
#
# Model calls use `ask_model`. The caller's headers select the provider.
# Served by `a11.demos.web_demos_server`; see
# doc/docs/guides/deep-research.md.

from std import join, startswith, strformat, to_chunk

flow plan-research {
  describe """
    Produce independent investigation briefs and a synthesis instruction.
    The final plan line supplies `synthesis`; preceding lines supply `briefs`.
    """

  in  topic: string required "Research topic."

  out briefs:    string stream "Independent investigation instructions."
  out synthesis: string        "Final report instruction."
  out narration: string stream
    "Planning progress messages."

  strformat("[plan] planning research on: %s", topic) -> narration

  llm = run ask_model(
    interactions: topic | map a11::sdk::Interaction{
      role: "user",
      system_instructions: [to_chunk("""
        You plan research. Given a topic, write a short plan for investigating
        it: one instruction per line, addressed to yourself, and nothing else --
        no numbering, no introduction, no blank lines.

        Use at most four lines. Each must be investigable on its own, because a
        different agent will carry out each one and they cannot see each other.

        The last line is the exception: start it with `FINALLY: ` and make it an
        instruction for writing the final report out of the others' findings.

        Answer in the language of the topic.
        """)],
      content: [to_chunk({
        role: "user",
        content: [{type: "text", text: strformat("The research topic is: %s", it
        )}]
      })]
    },
    config: {}
  )

  # Reassemble streamed text before splitting it into plan lines.
  lines = run split_lines(text: llm.text_output | join "")

  lines.lines | where not startswith(it, "FINALLY:") -> briefs
  lines.lines | where startswith(it, "FINALLY:") | first 1 -> synthesis
  lines.lines
    | where not startswith(it, "FINALLY:")
    | strformat "[plan] brief: %s"
    -> narration
}

flow investigate {
  describe "Investigate one brief within the research topic."

  in  topic: string required "Research topic."
  in  brief: string required "Investigation instruction."

  out report:    string "Investigation findings and sources."
  out narration: string stream
    "Investigation progress messages."

  strformat("[investigate] %s", brief) -> narration

  llm = run ask_model(
    interactions: brief | map a11::sdk::Interaction{
      role: "user",
      system_instructions: [to_chunk("""
        You are one of several research agents working on one topic. Carry out
        the brief you are given, and only that brief.

        Report what you found as short bullet points. Name the sources you
        relied on. Begin with one line saying which brief this answers. Answer
        in the language of the topic.
        """)],
      content: [to_chunk({
        role: "user",
        content: [{type: "text", text: join([
          strformat("The research topic is: %s", topic),
          strformat("Your brief is: %s", it)
        ], "\n\n")}]
      })]
    },
    config: {}
  )

  llm.text_output | join "" -> report

  # Emit completion progress after the model action finishes.
  done = wait llm
  strformat("[investigate] finished: %s", brief) -> narration after done
}

flow synthesise-findings {
  describe "Synthesise investigation findings into a report."

  in  topic:    string required        "Research topic."
  in  brief:    string required        "Report instruction."
  in  findings: string stream required "Investigation reports."

  out report:    string stream "Report text chunks."
  out narration: string stream
    "Synthesis progress messages."

  strformat("[synthesise] writing the report on: %s", topic) -> narration

  # Collect referenced findings before constructing the synthesis prompt.
  asked = node()
  findings
    | read_with {
        max_ref_depth: 2,
        max_ref_breadth: 3,
        num_chunks_to_buffer: 8
      }
    | collect
    | map join([
      strformat("The research topic is: %s", topic),
      strformat("Your instruction is: %s", brief),
      "Here is what the investigations found:",
      join(it, "\n\n---\n\n")
    ], "\n\n")
    -> asked

  llm = run ask_model(
    interactions: asked | map a11::sdk::Interaction{
      role: "user",
      system_instructions: [to_chunk("""
        You write the final report of a research project out of the
        intermediate findings you are given, following the instruction you are
        given. Keep the sources the findings cite. Answer in the language of
        the topic.
        """)],
      content: [to_chunk({
        role: "user",
        content: [{type: "text", text: it}]
      })]
    },
    config: {}
  )

  # Forward report text as it arrives.
  llm.text_output -> report
}

flow deep-research {
  describe "Plan a topic, investigate briefs concurrently, and synthesise a report."

  in  topic: string required "Research topic."

  out report: string stream "Report text chunks."
  out plan:   string stream "Investigation briefs."

  planned = run plan-research(topic: topic)
  for line in planned.narration {
    log info line
  }
  planned.briefs | ref -> plan

  nodes research {
    findings = node()

    for brief in planned.briefs parallel 3 {
      one = run investigate(topic: topic, brief: brief)
      one.report | ref -> findings
      for line in one.narration {
        log info line
      }
    }

    written = run synthesise-findings(
      topic: topic,
      brief: planned.synthesis,
      findings: findings,
    )
    written.report | ref -> report
    for line in written.narration {
      log info line
    }
  }
}
