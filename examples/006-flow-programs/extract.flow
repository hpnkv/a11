# a11-flow-run extract.flow -- BEGIN END < some-file
from std import startswith, strformat

flow {
  describe "Print lines between markers; exit 1 when no body was found."
  out exit_code: int

  arguments = argv | drop 1
  string start_marker = take arguments
  string end_marker = take arguments
  bool inside = false
  int count = 0
  body = node()
  input = run read_stdin()

  for line in input.lines {
    if startswith(line, start_marker) {
      inside = true
    } else if startswith(line, end_marker) {
      inside = false
    } else if inside {
      line -> body
      count = count + 1
    }
  }

  run write_stdout(content: body | map strformat("%s\n", it))
  if count > 0 {
    0 -> exit_code
  } else {
    1 -> exit_code
  }
}
