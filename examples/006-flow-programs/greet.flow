# a11-flow-run greet.flow -- Helena
from std import strformat, trim

flow {
  describe "Greet the first argument, or the world when none is supplied."

  string name = take (argv | drop 1 | then "world")
  run write_stdout(content: strformat("Hello, %s!\n", trim(name)))
}
