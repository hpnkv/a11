# a11-flow-run grep.flow -- warning < build.log
from std import contains, strformat

flow {
  describe "Print matching lines; exit 1 when nothing matches."
  out exit_code: int

  string needle = take (argv | drop 1)
  input = run read_stdin()
  matches = input.lines | where contains(it, needle)

  # Independent subscriptions both see every match.
  run write_stdout(content: matches | map strformat("%s\n", it))
  int count = take (matches | count)
  if count > 0 {
    0 -> exit_code
  } else {
    1 -> exit_code
  }
}
