# a11-flow-run normalize.flow < some-file

flow clean_lines {
  in  input: string stream

  out output: string stream
  input | map std::trim(it) | where std::len(it) > 0 -> output
}

flow number_lines {
  in  input:  string stream
  in  prefix: string

  out output: string stream

  string label = take prefix
  int number = 0
  for line in input {
    number = number + 1
    std::strformat("%s%d: %s\n", label, number, line) -> output
  }
}

flow {
  describe "Trim and number nonempty input lines."
  source = run read_stdin()
  lines = source.lines
    | run clean_lines()
    | run number_lines(prefix: "> ")
  run write_stdout(content: lines)
}
