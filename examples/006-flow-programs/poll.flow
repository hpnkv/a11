# a11-flow-run --root /var/log poll.flow -- /var/log/system.log
from std import default, strformat

flow {
  describe "Report file sizes until two readings agree, with at most 20 readings."
  out exit_code: int "0 when settled; 1 when the readings were exhausted."

  string path = take (argv | drop 1)
  int previous_size = -1
  bool settled = false
  report = node()
  stop = node()
  clock = run ticker(
    options: {every: "200ms", count: 20}, control_events: stop
  )

  readings = for tick in clock.ticks {
    file = run stat_path(path: path)
    info = take file.info
    int size = default(info.size, 0)
    strformat("%d: %d bytes\n", tick.number, size) -> report
    settled = size == previous_size
    previous_size = size
  } until settled

  # Ending the loop releases its reader; the control message stops the producer.
  {command: "stop"} -> stop after readings
  run write_stdout(content: report)
  if settled {
    0 -> exit_code
  } else {
    1 -> exit_code
  }
}
