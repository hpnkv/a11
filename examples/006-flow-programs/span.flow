# a11-flow-run span.flow -- "END OF" < build.log
from std import contains, join, strformat

flow {
  describe "Find a phrase across consecutive lines; exit 1 when absent."
  out exit_code: int

  string phrase = take (argv | drop 1)
  input = run read_stdin()
  matches = input.lines
    | window 2
    | where contains(join(it, "\n"), phrase)
    | map join(it, " / ")

  run write_stdout(content: matches | map strformat("%s\n", it))
  int count = take (matches | count)
  if count > 0 {
    0 -> exit_code
  } else {
    1 -> exit_code
  }
}
