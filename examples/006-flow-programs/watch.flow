# a11-flow-run watch.flow -- some.log
from std import default, strformat

flow {
  describe "Report a file's size once a second for ten seconds."

  string path = take (argv | drop 1)
  report = node()
  clock = run ticker(options: {every: "1s", for: "10s", immediate: true})

  for tick in clock.ticks {
    file = run stat_path(path: path)
    info = take file.info
    strformat("%d  %s  %d bytes\n",
      tick.number, info.modified, default(info.size, 0)) -> report
  }

  run write_stdout(content: report)
}
