# Watch a file's size, once a second, until it stops changing.
#
#   a11-flow-run watch.flow -- some.log
#
# `ticker` is the part Flow could not express before: a value that arrives
# because time passed rather than because something upstream produced one. With
# it, polling is an ordinary pipeline -- and the whole program is bounded by
# `--timeout` or by the ticker's own `for`, so it cannot run forever by
# accident.

flow {
  describe "Report a file's size once a second for ten seconds."

  nodes scratch
  path = node() in scratch
  report = node() in scratch
  argv | drop 1 | first 1 -> path

  clock = run ticker(options: {"every": "1s", "for": "10s", "immediate": true})
      via scratch
  skip skipped, count of clock

  # One `stat_path` per tick. `parallel` is deliberately absent: these are meant
  # to happen one after another, a second apart.
  for tick in clock.ticks {
    look = run stat_path(path: path) via scratch
    skip look.exists
    # The tick's own number, so the output says which reading this was -- and so
    # the loop variable is read, which the language checks for.
    look.info | map strformat("%d  %s  %d bytes\n", tick.number, it.modified,
      default(it.size, 0))
      -> report
  }

  out = run write_stdout(content: report) via scratch
  skip out.bytes_written
}
