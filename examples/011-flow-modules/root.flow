flow test {
  in  input: string stream "Lines to write."
  run write_stdout(content: input | map std::strformat("%s\n", it))
}

flow {
  input = run read_stdin()
  output = run test()

  "Hello!\n" -> output.input

  forwarded = input.lines
    | take until std::lower(it) == "/exit"
    | log info it
    -> output.input

  {command: "stop"} -> input.control_events after forwarded
}
