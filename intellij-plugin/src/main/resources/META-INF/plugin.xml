<idea-plugin>
    <id>dev.curiositystack.a11.clion</id>
    <name>A11 Chat</name>
    <vendor email="hello@curiositystack.dev" url="https://github.com/hpnkv/a11">Curiosity Stack</vendor>

    <description><![CDATA[
        An AI chat tool window for JetBrains IDEs, powered by <b>A11</b>. The chat runs
        against an <b>A11 gateway</b> (<code>a11 gateway</code>) over a WebSocket
        and can call tools backed by the IDE — open editors, project indexes,
        symbols, and refactorings — plus the
        gateway's shell tools, so the model can answer questions grounded in your
        actual project. The gateway is expected at
        <code>ws://127.0.0.1:8011/a11</code>; configure it under
        Preferences → Tools → A11 Chat.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="A11 Chat"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.curiositystack.a11.clion.ui.ChatToolWindowFactory"/>

        <toolWindow id="A11 Actions"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowRun"
                    factoryClass="dev.curiositystack.a11.clion.ui.ActionsToolWindowFactory"/>

        <!-- The A11 Flow language: `.flow` files, and flows inside the string
             literals of any host language (see FlowInjector). Nothing here
             depends on a product-specific module, so it works in every IDE. -->
        <fileType name="A11 Flow"
                  implementationClass="dev.curiositystack.a11.clion.flow.FlowFileType"
                  fieldName="INSTANCE"
                  language="A11Flow"
                  extensions="flow"/>
        <lang.parserDefinition
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowSyntaxHighlighterFactory"/>
        <lang.commenter
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowCommenter"/>
        <lang.braceMatcher
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowBraceMatcher"/>
        <colorSettingsPage
                implementation="dev.curiositystack.a11.clion.flow.FlowColorSettingsPage"/>
        <multiHostInjector
                implementation="dev.curiositystack.a11.clion.flow.FlowInjector"/>
        <completion.contributor
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowCompletionContributor"/>

        <!-- Everything that needs to know what a flow *means* asks the
             language: one `a11-flow serve` process per IDE (see FlowEngine).
             Diagnostics arrive as one external annotator rather than as
             inspections over a Kotlin resolver, because the checks, their
             messages, their severities and their fixes are all the language's,
             and an annotator is the platform's hook for asking something outside
             the IDE. Without the tool, the editor still colours what it can. -->
        <applicationService
                serviceImplementation="dev.curiositystack.a11.clion.flow.FlowEngine"/>
        <!-- One balloon, at most once: "there is no tool for this platform, so
             flows are coloured but not checked". A missing binary is a degraded
             editor rather than an error, and saying so twice is worse than
             once. -->
        <notificationGroup id="A11" displayType="BALLOON"/>
        <externalAnnotator
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowAnnotator"/>
        <formattingService
                implementation="dev.curiositystack.a11.clion.flow.FlowFormattingService"/>

        <!-- Hover, go-to-declaration and the structure view. A flow's PSI is a
             flat token stream on purpose, since there is no second parser in
             Kotlin, so none of these can be answered by walking a tree here.
             Each is a question about meaning, put to the language at an offset,
             which is also why hovering an action's name can show its ports. -->
        <lang.documentationProvider
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowDocumentationProvider"/>
        <lang.psiStructureViewFactory
                language="A11Flow"
                implementationClass="dev.curiositystack.a11.clion.flow.FlowStructureViewFactory"/>
        <gotoDeclarationHandler
                implementation="dev.curiositystack.a11.clion.flow.FlowDeclarationHandler"/>

        <applicationService serviceImplementation="dev.curiositystack.a11.clion.settings.A11Settings"/>
        <applicationConfigurable
                parentId="tools"
                instance="dev.curiositystack.a11.clion.settings.A11Configurable"
                id="dev.curiositystack.a11.clion.settings"
                displayName="A11 Chat"/>
    </extensions>
</idea-plugin>
