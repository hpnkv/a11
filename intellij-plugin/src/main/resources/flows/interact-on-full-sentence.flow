from std import endswith, trim, join, to_chunk

flow interact-on-full-sentence {
  describe "Listen for a sentence, then answer it as the next conversation turn."

  in  asr:     object required "Speech recognition options; model required."
  in  device:  object required "Which input to open on the client."
  in  history: string required "Id of the node holding earlier turns."

  out sentence: string "The sentence used as the question."
  out reply:    string stream                "The answer as it is written."
  out turn:     a11::sdk::Interaction stream "The interactions to remember."

  mic = call capture_audio(options: device) timeout 600s
  nodes scratch
  transcribe = run transcribe_audio(
    asr_options: asr, audio: mic.audio | packb
  ) via scratch

  # Capture one sentence once; both outputs and the model use the same value.
  string said = take (transcribe.transcription_pieces
      | group endswith(trim(it), [".", "?", "!"])
      | first 1
      | map trim(join(it, " ")))
  said -> sentence
  {command: "stop"} -> mic.control_events after said

  earlier = node(history)
  asked = a11::sdk::Interaction{
    role: "user",
    content: [to_chunk({
      role: "user",
      content: [{type: "text", text: said}]
    })]
  }

  interact = run interact_with_llm(
    interactions: earlier | then asked,
    config: {}
  ) forward headers "x-a11-llm-*" via scratch

  interact.text_output -> reply
  asked | then interact.new_interactions -> turn
}
