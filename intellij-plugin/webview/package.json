{
  "name": "a11-clion-webview",
  "version": "0.2.3",
  "private": true,
  "description": "JCEF host entry for the A11 JetBrains plugin: installs the bridge and bundles the shared UI.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --platform=browser --external:ws --minify --outfile=../src/main/resources/webview/app.js",
    "build:dev": "esbuild src/main.ts --bundle --format=iife --platform=browser --external:ws --sourcemap=inline --outfile=../src/main/resources/webview/app.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
