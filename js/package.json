{
  "name": "@curiositystack/a11",
  "version": "0.5.1",
  "description": "TypeScript client for the A11 streaming action runtime",
  "homepage": "https://docs.a11.to/typescript.html",
  "bugs": {
    "url": "https://github.com/hpnkv/a11/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpnkv/a11.git",
    "directory": "js"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "model-serving",
    "streaming"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:demo": "esbuild demo/browser_clients.ts --bundle --format=esm --outfile=../doc/docs/assets/browser-clients.js",
    "build:demo:local": "esbuild demo/local_models.ts --bundle --format=esm --outfile=../doc/docs/assets/local-models.js",
    "build:demo:chat": "esbuild demo/chat_sessions.ts --bundle --format=esm --outfile=../doc/docs/assets/chat-sessions.js",
    "build:demo:research": "esbuild demo/deep_research.ts --bundle --format=esm --outfile=../doc/docs/assets/deep-research.js",
    "build:demo:tools": "esbuild demo/browser_tools.ts --bundle --format=esm --outfile=../doc/docs/assets/browser-tools.js",
    "build:demo:media": "esbuild demo/generative_media.ts --bundle --format=esm --outfile=../doc/docs/assets/generative-media.js",
    "build:demo:p2p": "esbuild demo/p2p_chat/p2p_chat.ts --bundle --format=esm --outfile=../doc/docs/assets/p2p-chat.js",
    "build:demos": "npm run build:demo && npm run build:demo:local && npm run build:demo:chat && npm run build:demo:research && npm run build:demo:tools && npm run build:demo:media && npm run build:demo:p2p",
    "typecheck:demos": "tsc --project tsconfig.demo.json",
    "build:docs": "typedoc --options typedoc.json",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:demo:p2p": "esbuild demo/p2p_chat/tests/p2p_chat.test.ts --bundle --format=esm --platform=node --packages=external --outfile=../doc/docs/assets/p2p-chat.test.mjs && node --test ../doc/docs/assets/p2p-chat.test.mjs",
    "publish:registries": "npm run build && node scripts/publish_registries.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "three": "^0.185.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
