{
  "name": "@curiositystack/a11",
  "version": "0.2.1",
  "description": "TypeScript library for A11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpnkv/a11.git",
    "directory": "js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:demo": "esbuild demo/browser_clients.ts --bundle --format=esm --outfile=../doc/docs/assets/browser-clients.js",
    "build:demo:local": "esbuild demo/local_models.ts --bundle --format=esm --outfile=../doc/docs/assets/local-models.js",
    "build:docs": "typedoc --options typedoc.json",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test test/*.test.mjs",
    "publish:registries": "npm run build && node scripts/publish_registries.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
