+bool SctpTransport::setPathMtu(size_t mtu) {
+	if (mtu <= SCTP_MTU_HEADER_OVERHEAD)
+		return false;
+
+	std::lock_guard lock(mSendMutex);
+	if (state() != State::Connected)
+		return false;
+
+	// spp_address must be the *wildcard* for the association's family, which for
+	// usrsctp's userspace transport is AF_CONN with a null sconn_addr. It cannot
+	// simply be zeroed: with a live association usrsctp looks the address up
+	// (sctp_findnet), finds no matching destination, and then requires the
+	// address to be the family's wildcard -- a zeroed sockaddr has sa_family 0
+	// and falls through to EAFNOSUPPORT. The socket setup above gets away with a
+	// zeroed one only because it runs before usrsctp_connect, when there is no
+	// association to look up and the endpoint defaults are set instead.
+	//
+	// The wildcard form is what makes this assoc-wide: usrsctp then applies the
+	// value to every destination rather than to one path.
+	struct sctp_paddrparams spp = {};
+	auto *sconn = reinterpret_cast<struct sockaddr_conn *>(&spp.spp_address);
+	sconn->sconn_family = AF_CONN;
+	sconn->sconn_port = 0;
+	sconn->sconn_addr = NULL; // the wildcard: "every destination"
+#ifdef HAVE_SCONN_LEN
+	sconn->sconn_len = sizeof(struct sockaddr_conn);
+#endif
+	spp.spp_flags = SPP_PMTUD_DISABLE;
+	spp.spp_pathmtu = to_uint32(mtu - SCTP_MTU_HEADER_OVERHEAD);
+
+	if (usrsctp_setsockopt(mSock, IPPROTO_SCTP, SCTP_PEER_ADDR_PARAMS, &spp, sizeof(spp))) {
+		PLOG_WARNING << "SCTP set path MTU to " << mtu << " failed, errno=" << errno;
+		return false;
+	}
+
+	PLOG_DEBUG << "SCTP path MTU set to " << spp.spp_pathmtu << " (network MTU " << mtu << ")";
+	return true;
+}
+
+bool SctpTransport::setPacketCeiling(size_t mtu) {
+	if (mtu <= SCTP_MTU_HEADER_OVERHEAD)
+		return false;
+
+	std::lock_guard lock(mSendMutex);
+	if (state() != State::Connected)
+		return false;
+
+	// Same call as setPathMtu, and the difference is entirely on the usrsctp side:
+	// SPP_PMTUD_DISABLE with a path MTU writes net->mtu, and only the association
+	// refresh (patched in alongside this) propagates it to asoc->smallest_mtu.
+	// Reaching net->mtu without that refresh is what a probe wants.
+	struct sctp_paddrparams spp = {};
+	auto *sconn = reinterpret_cast<struct sockaddr_conn *>(&spp.spp_address);
+	sconn->sconn_family = AF_CONN;
+	sconn->sconn_port = 0;
+	sconn->sconn_addr = NULL;
+#ifdef HAVE_SCONN_LEN
+	sconn->sconn_len = sizeof(struct sockaddr_conn);
+#endif
+	spp.spp_flags = SPP_PMTUD_DISABLE | SPP_PACKET_CEILING_ONLY;
+	spp.spp_pathmtu = to_uint32(mtu - SCTP_MTU_HEADER_OVERHEAD);
+
+	if (usrsctp_setsockopt(mSock, IPPROTO_SCTP, SCTP_PEER_ADDR_PARAMS, &spp, sizeof(spp))) {
+		PLOG_WARNING << "SCTP set packet ceiling to " << mtu << " failed, errno=" << errno;
+		return false;
+	}
+	return true;
+}
+
+// `chunkSpace` is the SCTP chunk bytes the probe should carry, *not* a network
+// MTU: the caller has already taken the headers off. Subtracting them again here
+// made every probe test about 216 bytes less than the candidate it was meant to
+// measure, which is a false positive machine -- a candidate above the path limit
+// gets acknowledged because what actually went out was under it.
+bool SctpTransport::sendPathMtuProbe(size_t chunkSpace, uint32_t probeId) {
+	if ((chunkSpace == 0) || (probeId == 0))
+		return false;
+
+	std::lock_guard lock(mSendMutex);
+	if (state() != State::Connected)
+		return false;
+
+	struct sctp_pmtu_probe probe = {};
+	probe.spp_assoc_id = 0;
+	probe.spp_chunk_space = to_uint32(chunkSpace);
+	probe.spp_probe_id = probeId;
+	if (usrsctp_setsockopt(mSock, IPPROTO_SCTP, SCTP_SEND_PMTU_PROBE, &probe, sizeof(probe))) {
+		PLOG_DEBUG << "SCTP path MTU probe of " << chunkSpace
+		           << " chunk bytes not sent, errno=" << errno;
+		return false;
+	}
+	return true;
+}
+
+uint32_t SctpTransport::pathMtuProbeAckCount() {
+	std::lock_guard lock(mSendMutex);
+	if (state() != State::Connected)
+		return 0;
+
+	struct sctp_pmtu_probe probe = {};
+	probe.spp_assoc_id = 0;
+	socklen_t len = sizeof(probe);
+	if (usrsctp_getsockopt(mSock, IPPROTO_SCTP, SCTP_PMTU_PROBE_ACKED, &probe, &len))
+		return 0;
+	/* The spare request field carries the count back. */
+	return probe.spp_chunk_space;
+}
+
+uint32_t SctpTransport::acknowledgedPathMtuProbe() {
+	std::lock_guard lock(mSendMutex);
+	if (state() != State::Connected)
+		return 0;
+
+	struct sctp_pmtu_probe probe = {};
+	probe.spp_assoc_id = 0;
+	socklen_t len = sizeof(probe);
+	if (usrsctp_getsockopt(mSock, IPPROTO_SCTP, SCTP_PMTU_PROBE_ACKED, &probe, &len))
+		return 0;
+	return probe.spp_probe_id;
+}
