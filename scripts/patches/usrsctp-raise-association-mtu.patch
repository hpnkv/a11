diff --git a/usrsctplib/netinet/sctp_output.c b/usrsctplib/netinet/sctp_output.c
index 0a3453b..8e28006 100755
--- a/usrsctplib/netinet/sctp_output.c
+++ b/usrsctplib/netinet/sctp_output.c
@@ -12269,6 +12269,206 @@ sctp_send_hb(struct sctp_tcb *stcb, struct sctp_nets *net,int so_locked)
 	return;
 }
 
+/*
+ * Emits one path MTU probe: a HEARTBEAT padded to `chunk_space` bytes with a PAD
+ * chunk (RFC 4820), for packetization-layer path MTU discovery (RFC 8899).
+ *
+ * Written straight to the wire with sctp_lowlevel_chunk_output rather than queued
+ * on control_send_queue, and that is the whole design:
+ *
+ *   - **No MTU to manipulate.** The net->mtu cap lives in sctp_med_chunk_output,
+ *     which *builds* packets from the queues; the low-level output just writes the
+ *     packet it is handed. So a probe larger than the current path MTU needs no
+ *     ceiling raised, which means application traffic is never exposed to an
+ *     unconfirmed size -- not by fragmentation, and not by bundling either.
+ *   - **Sent once, never retransmitted.** RFC 8899 requires that losing a probe
+ *     not affect the protocol. A queued probe cannot deliver that here: it is by
+ *     construction larger than the ceiling, so once queued it can never be emitted
+ *     and it blocks every control chunk behind it -- which stalls the association's
+ *     heartbeats and SACKs and looks exactly like a dead path. That is not a
+ *     hypothetical; it is what the queue-based version of this function did, and
+ *     collecting the leftovers afterwards only moved the problem.
+ *
+ * The probe id travels in the heartbeat's random_value fields, which a confirmed
+ * destination sets to zero and never reads back, leaving time_value_1/2 free for
+ * the timestamp the RTT estimate uses. And net->hb_responded is deliberately not
+ * touched: a probe is *expected* to go unanswered at a size the path cannot carry,
+ * and counting that as a missed heartbeat would tear down the destination being
+ * measured.
+ *
+ * Returns 0 on success, or an errno.
+ */
+int
+sctp_send_pmtu_probe(struct sctp_tcb *stcb, struct sctp_nets *net,
+                     uint32_t chunk_space, uint32_t probe_id)
+{
+	struct mbuf *m, *tail;
+	struct sctp_heartbeat_chunk *hb;
+	struct sctp_paramhdr *pad;
+	struct timeval now;
+	uint32_t total, pad_len, left;
+	int error;
+	bool use_zero_crc;
+
+	SCTP_TCB_LOCK_ASSERT(stcb);
+	if ((net == NULL) || (probe_id == 0)) {
+		return (EINVAL);
+	}
+	switch (net->ro._l_addr.sa.sa_family) {
+#ifdef INET
+	case AF_INET:
+		break;
+#endif
+#ifdef INET6
+	case AF_INET6:
+		break;
+#endif
+#if defined(__Userspace__)
+	case AF_CONN:
+		break;
+#endif
+	default:
+		return (EINVAL);
+	}
+	/* Round down to the 4-byte alignment every chunk boundary needs: a probe one
+	 * byte off alignment would desynchronise the peer's chunk loop, which is far
+	 * worse than probing four bytes low. */
+	total = chunk_space & (uint32_t)~3U;
+	if (total < sizeof(struct sctp_heartbeat_chunk) + sizeof(struct sctp_paramhdr)) {
+		total = (uint32_t)(sizeof(struct sctp_heartbeat_chunk) +
+		                   sizeof(struct sctp_paramhdr));
+	}
+	pad_len = total - (uint32_t)sizeof(struct sctp_heartbeat_chunk);
+
+	/* A chain, not one buffer: MCLBYTES is 2048, so any probe past ~2 KiB cannot
+	 * be contiguous and asking for one simply fails. */
+	m = sctp_get_mbuf_for_msg(total, 1, M_NOWAIT, 0, MT_HEADER);
+	if (m == NULL) {
+		return (ENOMEM);
+	}
+	left = total;
+	for (tail = m; tail != NULL; tail = SCTP_BUF_NEXT(tail)) {
+		uint32_t room = (uint32_t)M_TRAILINGSPACE(tail);
+		uint32_t take = (left < room) ? left : room;
+
+		SCTP_BUF_LEN(tail) = (int)take;
+		if (take > 0) {
+			/* Zeroed because these buffers are recycled: padding that is never
+			 * written would put whatever they held before on the wire. */
+			memset(mtod(tail, caddr_t), 0, take);
+		}
+		left -= take;
+		if (left == 0) {
+			if (SCTP_BUF_NEXT(tail) != NULL) {
+				sctp_m_freem(SCTP_BUF_NEXT(tail));
+				SCTP_BUF_NEXT(tail) = NULL;
+			}
+			break;
+		}
+	}
+	if ((left > 0) ||
+	    ((uint32_t)SCTP_BUF_LEN(m) <
+	     sizeof(struct sctp_heartbeat_chunk) + sizeof(struct sctp_paramhdr))) {
+		/* Either the chain could not hold the request, or the heartbeat and the
+		 * PAD header would straddle a boundary -- under sixty bytes together, so
+		 * this only happens if the first buffer is tiny. Probe smaller rather
+		 * than emit something malformed. */
+		sctp_m_freem(m);
+		return (ENOMEM);
+	}
+	SCTP_BUF_LEN(m) = SCTP_BUF_LEN(m);
+
+	(void)SCTP_GETTIME_TIMEVAL(&now);
+	hb = mtod(m, struct sctp_heartbeat_chunk *);
+	hb->ch.chunk_type = SCTP_HEARTBEAT_REQUEST;
+	hb->ch.chunk_flags = 0;
+	/* The heartbeat's own length stays exactly what a receiver validates against;
+	 * the padding is the next chunk, not part of this one. */
+	hb->ch.chunk_length = htons((uint16_t)sizeof(struct sctp_heartbeat_chunk));
+	hb->heartbeat.hb_info.ph.param_type = htons(SCTP_HEARTBEAT_INFO);
+	hb->heartbeat.hb_info.ph.param_length = htons(sizeof(struct sctp_heartbeat_info_param));
+	hb->heartbeat.hb_info.time_value_1 = now.tv_sec;
+	hb->heartbeat.hb_info.time_value_2 = now.tv_usec;
+	hb->heartbeat.hb_info.random_value1 = probe_id;
+	hb->heartbeat.hb_info.random_value2 = probe_id;
+	hb->heartbeat.hb_info.addr_family = (uint8_t)net->ro._l_addr.sa.sa_family;
+#ifdef HAVE_SA_LEN
+	hb->heartbeat.hb_info.addr_len = net->ro._l_addr.sa.sa_len;
+#else
+	switch (net->ro._l_addr.sa.sa_family) {
+#ifdef INET
+	case AF_INET:
+		hb->heartbeat.hb_info.addr_len = sizeof(struct sockaddr_in);
+		break;
+#endif
+#ifdef INET6
+	case AF_INET6:
+		hb->heartbeat.hb_info.addr_len = sizeof(struct sockaddr_in6);
+		break;
+#endif
+#if defined(__Userspace__)
+	case AF_CONN:
+		hb->heartbeat.hb_info.addr_len = sizeof(struct sockaddr_conn);
+		break;
+#endif
+	default:
+		hb->heartbeat.hb_info.addr_len = 0;
+		break;
+	}
+#endif
+	switch (net->ro._l_addr.sa.sa_family) {
+#ifdef INET
+	case AF_INET:
+		memcpy(hb->heartbeat.hb_info.address, &net->ro._l_addr.sin.sin_addr,
+		       sizeof(net->ro._l_addr.sin.sin_addr));
+		break;
+#endif
+#ifdef INET6
+	case AF_INET6:
+		memcpy(hb->heartbeat.hb_info.address, &net->ro._l_addr.sin6.sin6_addr,
+		       sizeof(net->ro._l_addr.sin6.sin6_addr));
+		break;
+#endif
+#if defined(__Userspace__)
+	case AF_CONN:
+		memcpy(hb->heartbeat.hb_info.address, &net->ro._l_addr.sconn.sconn_addr,
+		       sizeof(net->ro._l_addr.sconn.sconn_addr));
+		break;
+#endif
+	default:
+		sctp_m_freem(m);
+		return (EINVAL);
+	}
+	pad = (struct sctp_paramhdr *)((caddr_t)hb +
+	                               sizeof(struct sctp_heartbeat_chunk));
+	pad->param_type = htons(SCTP_PAD_CHUNK);
+	pad->param_length = htons((uint16_t)pad_len);
+
+	switch (stcb->asoc.snd_edmid) {
+	case SCTP_EDMID_LOWER_LAYER_DTLS:
+		use_zero_crc = true;
+		break;
+	default:
+		use_zero_crc = false;
+		break;
+	}
+	stcb->asoc.pmtu_probe_id_sent = probe_id;
+	error = sctp_lowlevel_chunk_output(stcb->sctp_ep, stcb, net,
+	                                  (struct sockaddr *)&net->ro._l_addr,
+	                                  m, 0, NULL, 0, 0, 0, 0,
+	                                  stcb->sctp_ep->sctp_lport, stcb->rport,
+	                                  htonl(stcb->asoc.peer_vtag),
+	                                  net->port, NULL,
+#if defined(__FreeBSD__) && !defined(__Userspace__)
+	                                  0, 0,
+#endif
+	                                  use_zero_crc, SCTP_SO_LOCKED);
+	if (error == 0) {
+		SCTP_STAT_INCR(sctps_sendheartbeat);
+	}
+	return (error);
+}
+
