 #define SCTP_ACCEPT_ZERO_CHECKSUM       0x00000033
+/*
+ * Datagram packetization-layer path MTU discovery (RFC 8899).
+ *
+ * SCTP_SEND_PMTU_PROBE emits one probe packet of a requested size: a HEARTBEAT
+ * padded with a PAD chunk (RFC 4820) so the packet reaches that size without
+ * carrying user data and without changing how user messages are fragmented. The
+ * peer answers with a HEARTBEAT-ACK by itself -- padding is ignorable by
+ * specification, so no cooperation beyond conforming SCTP is required.
+ *
+ * SCTP_PMTU_PROBE_ACKED (read-only) reports the id of the most recently
+ * acknowledged probe. The caller chooses ids, so a search can tell an answer to
+ * the probe it is waiting for from a late answer to the previous one.
+ */
+#define SCTP_SEND_PMTU_PROBE            0x00000034
+#define SCTP_PMTU_PROBE_ACKED           0x00000035
 
 /*
  * read-only options
