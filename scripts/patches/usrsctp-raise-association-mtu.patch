diff --git a/usrsctplib/netinet/sctp_usrreq.c b/usrsctplib/netinet/sctp_usrreq.c
index 53aeaa1..eea3b12 100755
--- a/usrsctplib/netinet/sctp_usrreq.c
+++ b/usrsctplib/netinet/sctp_usrreq.c
@@ -198,6 +198,35 @@ sctp_finish(void)
 }
 #endif
 
+/*
+ * Recomputes the association MTU as the smallest of its destinations' current
+ * MTUs and applies it if it changed.
+ *
+ * The SCTP_PEER_ADDR_PARAMS call sites used to test `net->mtu <
+ * asoc->smallest_mtu` and adjust only then, which can notice a destination
+ * getting smaller and never one getting larger -- so raising a path MTU left the
+ * association fragmenting to the old, smaller value and the change had no effect
+ * on anything but chunk bundling. Deriving the association value from the
+ * destinations, rather than testing one direction of one destination, is correct
+ * either way and is what makes an upward path MTU search possible.
+ */
+static void
+sctp_refresh_association_mtu(struct sctp_tcb *stcb, bool resend)
+{
+	struct sctp_nets *mtu_net;
+	uint32_t smallest;
+
+	smallest = 0;
+	TAILQ_FOREACH(mtu_net, &stcb->asoc.nets, sctp_next) {
+		if ((smallest == 0) || (mtu_net->mtu < smallest)) {
+			smallest = mtu_net->mtu;
+		}
+	}
+	if ((smallest > 0) && (smallest != stcb->asoc.smallest_mtu)) {
+		sctp_pathmtu_adjustment(stcb, smallest, resend);
+	}
+}
