index a3c1476..8b9138a 100755
--- a/usrsctplib/netinet/sctp_input.c
+++ b/usrsctplib/netinet/sctp_input.c
@@ -679,6 +679,17 @@ sctp_handle_heartbeat_ack(struct sctp_heartbeat_chunk *cp,
