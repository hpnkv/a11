+/* Argument to SCTP_SEND_PMTU_PROBE. @see SCTP_SEND_PMTU_PROBE */
+struct sctp_pmtu_probe {
+	sctp_assoc_t spp_assoc_id;
+	/* Total SCTP chunk bytes the probe packet should carry, i.e. the packet
+	 * size less the SCTP common header -- the same unit as
+	 * sctp_paddrparams::spp_pathmtu. */
+	uint32_t spp_chunk_space;
+	/* Caller-chosen id, echoed back through SCTP_PMTU_PROBE_ACKED. Must be
+	 * non-zero; zero means "no probe outstanding". */
+	uint32_t spp_probe_id;
+};
 
