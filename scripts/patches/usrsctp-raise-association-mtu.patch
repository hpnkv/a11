+++ b/usrsctplib/netinet/sctp_uio.h
@@ -591,6 +591,29 @@ struct sctp_paddrparams {
 #define SPP_IPV6_FLOWLABEL      0x00000100
 #define SPP_DSCP                0x00000200
 #define SPP_IPV4_TOS            SPP_DSCP
